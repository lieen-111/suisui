{
  "name": "suisui-locktodo-prototype",
  "version": "0.3.0",
  "private": true,
  "description": "碎碎清单：可用的 PWA 测试版 + 原生 iOS 锁屏工程（小组件 / 实时活动）。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/server.cjs",
    "test": "node scripts/verify.cjs",
    "test:completion": "node scripts/verify-completion.cjs",
    "test:pwa": "node scripts/verify-pwa.cjs",
    "capture": "node scripts/capture.cjs",
    "test:beta": "node scripts/verify-beta.cjs",
    "test:all": "node scripts/verify.cjs && node scripts/verify-completion.cjs && node scripts/verify-beta.cjs && node scripts/verify-pwa.cjs",
    "check:swift": "python scripts/check-swift-syntax.py",
    "test:v2": "node scripts/verify-v2.cjs",
    "test:ios-bridge": "node scripts/verify-ios-bridge.cjs",
    "test:v17": "node scripts/verify-v17.cjs",
    "test:v19": "node scripts/verify-v19.cjs",
    "test:v116": "node scripts/verify-v116.cjs",
    "test:v118": "node scripts/verify-v118.cjs",
    "test:layout": "node scripts/verify-layout.cjs",
    "build:night": "python3 scripts/build-night-css.py",
    "test:pro": "node scripts/verify-pro.cjs",
    "server": "node --no-warnings server/index.mjs",
    "test:server": "node scripts/verify-server.cjs",
    "test:pay": "node scripts/verify-pay.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
